{
  "uid": "spring-graphql",
  "title": "Spring GraphQL",
  "tags": [
    "graphql",
    "spring-boot"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(graphql_request_seconds_count, application)",
          "refId": "app"
        },
        "definition": "label_values(graphql_request_seconds_count, application)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "GraphQL requests",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests / s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(graphql_request_seconds_count{application=\"$application\"}[$__rate_interval]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(graphql_request_seconds_count{application=\"$application\", graphql_outcome!=\"SUCCESS\"}[$__rate_interval])) / sum(rate(graphql_request_seconds_count{application=\"$application\"}[$__rate_interval]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Average response time",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(graphql_request_seconds_sum{application=\"$application\"}[$__rate_interval])) / sum(rate(graphql_request_seconds_count{application=\"$application\"}[$__rate_interval]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "p95 response time",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(graphql_request_seconds_bucket{application=\"$application\"}[$__rate_interval])))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests / s by outcome and operation type",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (graphql_outcome, graphql_operation_type) (rate(graphql_request_seconds_count{application=\"$application\"}[$__rate_interval]))",
          "legendFormat": "{{graphql_operation_type}} {{graphql_outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Response time percentiles",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(graphql_request_seconds_bucket{application=\"$application\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(graphql_request_seconds_bucket{application=\"$application\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(graphql_request_seconds_bucket{application=\"$application\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C"
        },
        {
          "expr": "sum(rate(graphql_request_seconds_sum{application=\"$application\"}[$__rate_interval])) / sum(rate(graphql_request_seconds_count{application=\"$application\"}[$__rate_interval]))",
          "legendFormat": "average",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "row",
      "title": "GraphQL fields (data fetchers)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Most called fields (selected time range)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "expr": "topk(15, sum by (graphql_field_name) (increase(graphql_datafetcher_seconds_count{application=\"$application\"}[$__range])))",
          "legendFormat": "{{graphql_field_name}}",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "description": "Number of calls per GraphQL field (query / mutation / controller method) over the selected time range."
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Slowest fields - average (selected time range)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "expr": "topk(15, sum by (graphql_field_name) (increase(graphql_datafetcher_seconds_sum{application=\"$application\"}[$__range])) / sum by (graphql_field_name) (increase(graphql_datafetcher_seconds_count{application=\"$application\"}[$__range])) > 0)",
          "legendFormat": "{{graphql_field_name}}",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Slowest fields - p95 (selected time range)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "expr": "topk(15, histogram_quantile(0.95, sum by (graphql_field_name, le) (increase(graphql_datafetcher_seconds_bucket{application=\"$application\"}[$__range]))))",
          "legendFormat": "{{graphql_field_name}}",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Calls / s per field (top 10)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "topk(10, sum by (graphql_field_name) (rate(graphql_datafetcher_seconds_count{application=\"$application\"}[$__rate_interval])))",
          "legendFormat": "{{graphql_field_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Average response time per field",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "sum by (graphql_field_name) (rate(graphql_datafetcher_seconds_sum{application=\"$application\"}[$__rate_interval])) / sum by (graphql_field_name) (rate(graphql_datafetcher_seconds_count{application=\"$application\"}[$__rate_interval]))",
          "legendFormat": "{{graphql_field_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Errors / s per field",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (graphql_field_name, graphql_error_type) (rate(graphql_datafetcher_seconds_count{application=\"$application\", graphql_outcome!=\"SUCCESS\"}[$__rate_interval])) > 0",
          "legendFormat": "{{graphql_field_name}} ({{graphql_error_type}})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}